generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===================
// Enums
// ===================

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum Gender{
  MALE
  FEMALE
  OTHER
}

enum VerificationCodeType {
  REGISTER
  FORGOT_PASSWORD
  LOGIN
  DISABLE_2FA
}

enum HTTPMethod {
  GET
  POST
  PUT
  DELETE
  PATCH
  OPTIONS
  HEAD
}

enum ProjectMemberStatus {
  ACTIVE
  PENDING
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DependencyType {
  FS
  SS
  FF
  SF
}

enum NotificationType {
  project_created
  project_updated
  project_deleted
  project_invitation
  project_role_changed
  project_member_removed
  project_member_joined
  invitation_accepted
  member_role_changed
  member_removed
  sprint_started
  sprint_completed
  sprint_created
  sprint_deleted
  sprint_updated
  task_created
  task_assigned
  task_updated
  task_deleted
  task_moved
  task_commented
}

// =================== 
// Models
// ===================

model User {
  id             Int              @id @default(autoincrement())
  email          String           @unique 
  password       String           
  displayName    String           
  roleId         Int
  role           Role               @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  totpSecret                  String?               @db.VarChar(1000)
  status         UserStatus       @default(INACTIVE)
  phoneNumber    String?          
  address        String?          
  dob            DateTime?        @db.Date
  bio           String? 
  gender         Gender?          
  avatar         String?            
  avatarPublicId String?

  // 1 user có thể tạo ra nhiều user khác
  // 1 user chỉ có thể được tạo ra bởi 1 user khác
  // Tự quan hệ 1-n
  createdById  Int?
  createdBy    User?  @relation("CreatorUsers", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  createdUsers User[] @relation("CreatorUsers")

  updatedById  Int?
  updatedBy    User?  @relation("UpdatorUsers", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedUsers User[] @relation("UpdatorUsers")
  deletedById  Int?
  deletedBy    User?  @relation("DeletorUsers", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deletedUsers User[] @relation("DeletorUsers")

  createdAt      DateTime         @default(now())
  updatedAt      DateTime?        @updatedAt
  deletedAt      DateTime?      

  createdPermissions          Permission[]          @relation("PermissionCreatedBy")
  updatedPermissions          Permission[]          @relation("PermissionUpdatedBy")
  deletedPermissions          Permission[]          @relation("PermissionDeletedBy")  
  createdRoles                Role[]                @relation("RoleCreatedBy")
  updatedRoles                Role[]                @relation("RoleUpdatedBy")
  deletedRoles                Role[]                @relation("RoleDeletedBy")
  createdProjects             Project[]             @relation("ProjectCreatedBy")
  updatedProjects             Project[]             @relation("ProjectUpdatedBy")
  deletedProjects             Project[]             @relation("ProjectDeletedBy")
  updatedProjectMembers       ProjectMember[]       @relation("ProjectMemberUpdatedBy")
  deletedProjectMembers       ProjectMember[]       @relation("ProjectMemberDeletedBy")
  invitedProjectMembers       ProjectMember[]       @relation("ProjectMemberInvitedBy")
  createdSprints              Sprint[]              @relation("SprintCreatedBy")
  updatedSprints              Sprint[]              @relation("SprintUpdatedBy")
  deletedSprints              Sprint[]              @relation("SprintDeletedBy")
  createdBoardColumns         BoardColumn[]           @relation("BoardColumnCreatedBy")
  updatedBoardColumns         BoardColumn[]           @relation("BoardColumnUpdatedBy")
  deletedBoardColumns         BoardColumn[]           @relation("BoardColumnDeletedBy")
  createdTasks                Task[]                @relation("TaskCreatedBy")
  updatedTasks                Task[]                @relation("TaskUpdatedBy")
  deletedTasks                Task[]                @relation("TaskDeletedBy")
  taskAssignees             TaskAssignee[]        @relation("TaskAssigneeCreatedBy")
  taskLabels                TaskLabel[]           @relation("TaskLabelCreatedBy")
  taskComments                TaskComment[]         @relation("TaskCommentCreatedBy")
  taskAttachments             TaskAttachment[]      @relation("TaskAttachmentCreatedBy")
  projectChats                ProjectChat[]           @relation("ProjectChatCreatedBy")
  projectChatMessages         ProjectChatMessage[]    @relation("ProjectChatMessageCreatedBy")
  updatedTaskAssignees        TaskAssignee[]        @relation("TaskAssigneeUpdatedBy")
  updatedTaskLabels           TaskLabel[]           @relation("TaskLabelUpdatedBy")
  updatedTaskComments         TaskComment[]         @relation("TaskCommentUpdatedBy")
  updatedTaskAttachments      TaskAttachment[]      @relation("TaskAttachmentUpdatedBy")
  updatedProjectChats         ProjectChat[]           @relation("ProjectChatUpdatedBy")
  updatedProjectChatMessages    ProjectChatMessage[]    @relation("ProjectChatMessageUpdatedBy")
  deletedTaskAssignees        TaskAssignee[]        @relation("TaskAssigneeDeletedBy")
  deletedTaskLabels           TaskLabel[]           @relation("TaskLabelDeletedBy")
  deletedTaskComments         TaskComment[]         @relation("TaskCommentDeletedBy")
  deletedTaskAttachments      TaskAttachment[]      @relation("TaskAttachmentDeletedBy")
  deletedProjectChats         ProjectChat[]           @relation("ProjectChatDeletedBy")
  deletedProjectChatMessages    ProjectChatMessage[]    @relation("ProjectChatMessageDeletedBy")
  

  notifications               Notification[] 
  devices Device[]
  refreshTokens RefreshToken[]
  ownedProjects  Project[]        @relation("ProjectOwnedBy")
  projectMembers ProjectMember[]  @relation("ProjectMembers")
  taskAssignments TaskAssignee[]  @relation("TaskAssignments")
  memberComments  TaskComment[]   @relation("TaskCommentMember")
  chatMessages   ProjectChatMessage[]

  @@index([deletedAt])
}

model VerificationCode {
  id    Int                  @id @default(autoincrement())
  email String               @db.VarChar(500)
  code  String               @db.VarChar(50)
  type  VerificationCodeType

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([email, code, type])
  @@unique([email, type])
  @@index([expiresAt])
}

model Device {
  id            Int            @id @default(autoincrement())
  userId        Int
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction) 
  userAgent     String
  ip            String
  lastActive    DateTime       @updatedAt
  createdAt     DateTime       @default(now())
  isActive      Boolean        @default(true) 
  refreshTokens RefreshToken[] 
}

model RefreshToken {
  token     String   @unique @db.VarChar(1000)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  deviceId  Int 
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(500)
  description String       @default("")
  isActive    Boolean      @default(true)
  permissions Permission[]
  users       User[]
  roles       ProjectMember[]

  createdById Int?
  createdBy   User? @relation("RoleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedById Int?
  updatedBy   User? @relation("RoleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deletedById Int?
  deletedBy   User? @relation("RoleDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deletedAt])
}

model Permission {
  id          Int        @id @default(autoincrement())
  name        String     @db.VarChar(500)
  description String     @default("")
  path        String     @db.VarChar(1000)
  method      HTTPMethod
  module      String     @default("") @db.VarChar(500)
  roles       Role[]

  createdById Int?
  createdBy   User? @relation("PermissionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedById Int?
  updatedBy   User? @relation("PermissionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deletedById Int?
  deletedBy   User? @relation("PermissionDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deletedAt])
}

model Project {
  id            Int              @id @default(autoincrement())
  ownerId       Int
  name          String
  description   String?
  image      String?

  createdById Int?
  createdBy   User? @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedById Int?
  updatedBy   User? @relation("ProjectUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deletedById Int?
  deletedBy   User? @relation("ProjectDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  createdAt     DateTime         @default(now())
  updatedAt     DateTime?        @updatedAt
  deletedAt     DateTime?

  owner         User             @relation("ProjectOwnedBy", fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  members       ProjectMember[] @relation("ProjectMembers")
  sprints       Sprint[]
  chat          ProjectChat?
  notifications Notification[]

  @@index([deletedAt])
}

model ProjectMember {
  id          Int                @id @default(autoincrement())
  projectId   Int
  memberId    Int
  email       String
  roleId      Int
  role        Role                 @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status      ProjectMemberStatus @default(PENDING)
  inviteToken String?
  joinAt      DateTime?

  invitedById Int?
  invitedBy   User? @relation("ProjectMemberInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedById Int?
  updatedBy   User? @relation("ProjectMemberUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deletedById Int?
  deletedBy   User? @relation("ProjectMemberDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: NoAction)


  invitedAt   DateTime           @default(now())
  updatedAt   DateTime?          @updatedAt
  deletedAt   DateTime?

  project     Project            @relation("ProjectMembers", fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  member      User               @relation("ProjectMembers", fields: [memberId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([deletedAt])
}

model Sprint {
  id            Int          @id @default(autoincrement())
  projectId     Int
  name          String
  goal          String?
  maxStoryPoint Int          @default(0)
  startDate     DateTime
  endDate       DateTime
  status        SprintStatus @default(PLANNED)
  boardColumnIds Int[]       @default([])

  createdById Int?
  createdBy   User? @relation("SprintCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedById Int?
  updatedBy   User? @relation("SprintUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deletedById Int?
  deletedBy   User? @relation("SprintDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: NoAction)


  createdAt     DateTime     @default(now())
  updatedAt     DateTime?
  deletedAt     DateTime?

  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  boardColumns  BoardColumn[]
  tasks         Task[]

  @@index([projectId])
  @@index([deletedAt])
}

model BoardColumn {
  id        Int              @id @default(autoincrement())
  sprintId  Int
  title     String
  
  createdById Int?
  createdBy   User? @relation("BoardColumnCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedById Int?
  updatedBy   User? @relation("BoardColumnUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deletedById Int?
  deletedBy   User? @relation("BoardColumnDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: NoAction)


  createdAt     DateTime     @default(now())
  updatedAt     DateTime?
  deletedAt     DateTime?

  sprint    Sprint           @relation(fields: [sprintId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tasks     Task[]
  taskOrders BoardColumnTaskOrder[]

  @@index([deletedAt, sprintId])
}

model BoardColumnTaskOrder {
  id            Int         @id @default(autoincrement())
  boardColumnId Int
  taskId        Int
  sortOrder     Int 

  boardColumn   BoardColumn @relation(fields: [boardColumnId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  task          Task        @relation(fields: [taskId], references: [id])

  @@index([boardColumnId, taskId])
}

model Task {
  id            Int           @id @default(autoincrement())
  sprintId      Int
  boardColumnId Int
  title         String
  description   String?
  priority      TaskPriority?
  storyPoint    Int           @default(0)
  dueDate       DateTime?
  startDate     DateTime?
  duration      Int?          @default(0)
  parentId      Int?

  createdById Int?
  createdBy   User? @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedById Int?
  updatedBy   User? @relation("TaskUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deletedById Int?
  deletedBy   User? @relation("TaskDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime?     @updatedAt
  deletedAt     DateTime?

  sprint        Sprint        @relation(fields: [sprintId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  boardColumn   BoardColumn   @relation(fields: [boardColumnId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assignees     TaskAssignee[]
  labels        TaskLabel[]
  comments      TaskComment[]
  attachments   TaskAttachment[]
  notifications Notification[]
  boardColumnTaskOrders BoardColumnTaskOrder[]

  parent        Task?         @relation("SubTasks", fields: [parentId], references: [id], onDelete: Cascade)
  subTasks      Task[]        @relation("SubTasks")
  predecessors  TaskDependency[] @relation("SuccessorTasks")
  successors    TaskDependency[] @relation("PredecessorTasks")

  @@index([sprintId])
  @@index([boardColumnId])
  @@index([deletedAt])
}

model TaskDependency {
  id            Int            @id @default(autoincrement())
  predecessorId Int
  successorId   Int
  type          DependencyType @default(FS)
  lag           Int            @default(0)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime?      @updatedAt

  predecessor   Task           @relation("PredecessorTasks", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor     Task           @relation("SuccessorTasks", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId])
  @@index([predecessorId])
  @@index([successorId])
}

model TaskAssignee {
  id     Int  @id @default(autoincrement())
  taskId Int
  userId Int

  createdById Int?
  createdBy   User? @relation("TaskAssigneeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedById Int?
  updatedBy   User? @relation("TaskAssigneeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deletedById Int?
  deletedBy   User? @relation("TaskAssigneeDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  createdAt     DateTime @default(now())
  updatedAt     DateTime? @updatedAt
  deletedAt     DateTime?

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user   User @relation("TaskAssignments", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([taskId])
  @@index([userId])
  @@unique([taskId, userId])
}

model TaskLabel {
  id     Int    @id @default(autoincrement())
  taskId Int
  label  String

  createdById Int?
  createdBy   User? @relation("TaskLabelCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedById Int?
  updatedBy   User? @relation("TaskLabelUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deletedById Int?
  deletedBy   User? @relation("TaskLabelDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  createdAt     DateTime @default(now())
  updatedAt     DateTime? @updatedAt
  deletedAt     DateTime?

  task   Task   @relation(fields: [taskId], references: [id])

  @@index([taskId])
}

model TaskComment {
  id                Int      @id @default(autoincrement())
  taskId            Int
  memberId          Int
  memberDisplayName String
  memberAvatar      String?
  content           String

  createdById Int?
  createdBy   User? @relation("TaskCommentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedById Int?
  updatedBy   User? @relation("TaskCommentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deletedById Int?
  deletedBy   User? @relation("TaskCommentDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  createdAt         DateTime @default(now())
  updatedAt         DateTime? @updatedAt
  deletedAt         DateTime?

  task              Task     @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  member            User     @relation("TaskCommentMember", fields: [memberId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([taskId])
  @@index([memberId])
  @@index([deletedAt])
}

model TaskAttachment {
  id        Int      @id @default(autoincrement())
  taskId    Int
  fileName  String
  fileType  String
  fileUrl   String

  createdById Int?
  createdBy   User? @relation("TaskAttachmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedById Int?
  updatedBy   User? @relation("TaskAttachmentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deletedById Int?
  deletedBy   User? @relation("TaskAttachmentDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt
  deletedAt DateTime?

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([taskId])
  @@index([deletedAt])
}

model ProjectChat {
  id              Int      @id @default(autoincrement())
  projectId       Int      @unique
  lastMessage     String?
  lastMessageTime DateTime?

  createdById Int?
  createdBy   User? @relation("ProjectChatCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedById Int?
  updatedBy   User? @relation("ProjectChatUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deletedById Int?
  deletedBy   User? @relation("ProjectChatDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  createdAt       DateTime @default(now())
  updatedAt       DateTime? @updatedAt
  deletedAt       DateTime?

  project         Project  @relation(fields: [projectId], references: [id])
  messages        ProjectChatMessage[]
  
  @@index([deletedAt])
}

model ProjectChatMessage {
  id              Int      @id @default(autoincrement())
  projectChatId   Int
  senderId        Int
  senderName      String
  senderRole      String
  senderAvatarUrl String?
  message         String?
  attachmentFileName String?
  attachmentFileType String?
  attachmentFileUrl  String?
  attachmentFileSize Int?
  attachmentPublicId String?
  timestamp       DateTime @default(now())
  isDeleted       Boolean  @default(false)

  createdById Int?
  createdBy   User? @relation("ProjectChatMessageCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedById Int?
  updatedBy   User? @relation("ProjectChatMessageUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deletedById Int?
  deletedBy   User? @relation("ProjectChatMessageDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  createdAt       DateTime @default(now())
  updatedAt       DateTime? @updatedAt
  deletedAt       DateTime?

  chat            ProjectChat @relation(fields: [projectChatId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sender          User        @relation(fields: [senderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([projectChatId])
  @@index([senderId])
  @@index([deletedAt])
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int?
  projectId Int?
  taskId    Int?
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User?            @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project   Project?         @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  task      Task?            @relation(fields: [taskId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@index([projectId])
  @@index([taskId])
}
